{
  "name": "ormbridge",
  "version": "0.1.0",
  "description": "Convert ORM models between frameworks and languages. Define your data model once and share typed schemas across your stack.",
  "author": {
    "name": "Richard McQuiston",
    "email": "richard.mcquiston01@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ormbridge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "django",
    "prisma",
    "orm",
    "schema",
    "schema-converter",
    "django-to-prisma",
    "prisma-to-django",
    "django-models",
    "prisma-schema",
    "models.py",
    "migration",
    "database",
    "code-generation",
    "codegen",
    "cli",
    "tree-sitter",
    "typescript",
    "python",
    "typeorm",
    "graphene"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
