<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the migrations and the model snapshot that the real EF Core 8 generates for a sequence of C# models, and
    describes the final model the way EF Core itself sees it (IRelationalModel). test/efcore-migrations-verify.test.ts
    copies this project to a temporary directory, passes FixturesDir (the models, one namespace per version) and a
    manifest, and replays the generated migrations with ormbridge to compare the result with that description.
    The fixtures rely on the implicit usings of the SDK (System, System.Collections.Generic, System.Linq).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A package advisory or the end of support of a framework is not a problem of the code under test. -->
    <NuGetAudit>false</NuGetAudit>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NETSDK1138;NU1510</WarningsNotAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- EF1001: the design-time services of the providers live in Internal namespaces. CS8618: hand-written fixtures. -->
    <NoWarn>$(NoWarn);CS0169;CS8618;EF1001</NoWarn>
    <FixturesDir Condition="'$(FixturesDir)' == ''">Fixtures</FixturesDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(FixturesDir)/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- Brings the migration code generators; the tool never runs `dotnet ef`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
  </ItemGroup>

</Project>
