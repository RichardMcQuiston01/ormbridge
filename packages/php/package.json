{
  "name": "ormbridge-php",
  "version": "0.1.0",
  "description": "PHP ORMs for ormbridge: Doctrine entities and Laravel migrations and Eloquent models, read into the shared schema and written from any other format.",
  "author": {
    "name": "Richard McQuiston",
    "email": "richard.mcquiston01@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ormbridge",
    "ormbridge-plugin",
    "doctrine",
    "laravel",
    "eloquent",
    "php",
    "orm",
    "schema",
    "codegen"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ormbridge": ">=0.22.0"
  },
  "dependencies": {
    "web-tree-sitter": "0.22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ormbridge.git",
    "directory": "packages/php"
  },
  "homepage": "https://github.com/RichardMcQuiston01/ormbridge/blob/main/packages/php/README.md",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/ormbridge/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/P1V529Z7ZP"
  },
  "ormbridgeGrammars": [
    "php"
  ]
}
