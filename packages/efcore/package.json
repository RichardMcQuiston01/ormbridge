{
  "name": "ormbridge-efcore",
  "version": "0.1.0",
  "description": "Entity Framework Core (C#) models for ormbridge: read DbContext, entity classes and migrations into the shared schema, and write them from any other format.",
  "author": {
    "name": "Richard McQuiston",
    "email": "richard.mcquiston01@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ormbridge",
    "ormbridge-plugin",
    "efcore",
    "entity-framework",
    "dotnet",
    "csharp",
    "orm",
    "schema",
    "codegen"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ormbridge": ">=0.22.0"
  },
  "dependencies": {
    "web-tree-sitter": "0.22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ormbridge.git",
    "directory": "packages/efcore"
  },
  "homepage": "https://github.com/RichardMcQuiston01/ormbridge/blob/main/packages/efcore/README.md",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/ormbridge/issues"
  },
  "funding": {
    "type": "individual",
