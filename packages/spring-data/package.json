{
  "name": "ormbridge-spring-data",
  "version": "0.1.0",
  "description": "Spring Data JPA entities for ormbridge: Java or Kotlin classes with Spring auditing annotations and a JpaRepository per entity, read into and written from the shared schema.",
  "author": {
    "name": "Richard McQuiston",
    "email": "richard.mcquiston01@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ormbridge",
    "ormbridge-plugin",
    "spring",
    "spring-data",
    "spring-boot",
    "jpa",
    "hibernate",
    "java",
    "kotlin",
    "orm",
    "schema",
    "codegen"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ormbridge": ">=0.21.0"
  },
  "dependencies": {
    "ormbridge-kotlin": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ormbridge.git",
    "directory": "packages/spring-data"
  },
  "homepage": "https://github.com/RichardMcQuiston01/ormbridge/blob/main/packages/spring-data/README.md",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/ormbridge/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/P1V529Z7ZP"
  }
}
